# Copy to .env and fill in. Every value here has a working default,
# so the app runs with an empty .env - just in heuristic/offline mode.

# --- Creative Director (LLM) ---------------------------------------------
# gemini | groq | mock      mock = energy heuristic, no network, always works
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Speech to text -------------------------------------------------------
# local | groq | mock       local = faster-whisper on CPU, no key needed
STT_PROVIDER=local
WHISPER_MODEL=base.en
WHISPER_COMPUTE=int8
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- Narration ------------------------------------------------------------
# edge | piper | mock       edge = edge-tts, no key, sounds human
TTS_PROVIDER=edge
TTS_VOICE=en-US-AndrewNeural
PIPER_BIN=
PIPER_VOICE=

# --- Development ----------------------------------------------------------
# Comma-separated stages to skip with canned results. Use this to keep the
# pipeline end-to-end green while you are still writing a stage.
#   transcribing,analyzing_video,directing,rendering
STUB_STAGES=
USE_CACHE=1

# --- Tuning ---------------------------------------------------------------
TARGET_CLIPS=4
BUCKET_SECONDS=0.5
VISION_SAMPLE_FPS=4

# Stills shown to the Director so it can see what the footage is of, not just
# where the busy parts are. Gemini only (Groq's model is text-only and is told
# so). 0 disables them - the reel still renders, the narration just gets vaguer.
DIRECTOR_FRAMES=8
DIRECTOR_FRAME_WIDTH=512

RENDER_WIDTH=1280
RENDER_HEIGHT=720
RENDER_FPS=30
MUSIC_VOLUME=0.12
DUCK_VOLUME=0.15

# Optional. Font for the on-screen clip titles. Left empty we look for a bold
# sans in the usual places on Windows, macOS and Linux; set it only to force a
# particular face. If nothing is found the reel renders without titles.
#   C:/Windows/Fonts/arialbd.ttf
#   /System/Library/Fonts/Supplemental/Arial Bold.ttf
#   /usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
FONT_FILE=
